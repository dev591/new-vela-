api_key="" 
OPENAI_API_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
GOOGLE_MAPS_KEY=""
VITE_MAPBOX_TOKEN=""
# Required: the backend uses only the service-role key (RLS blocks the anon key).
SUPABASE_SERVICE_ROLE_KEY=""

# Extra comma-separated CORS origins for deployed frontends, e.g. "https://app.example.com"
CORS_ORIGINS=""

# Off by default. Set to "true" only for a local presentation/judged-demo
# environment — it grants a one-tap patient session with no password
# (/api/demo/login-patient). Never enable this anywhere publicly reachable.
DEMO_LOGIN="false"

# Atlas voice (ElevenLabs), proxied through /api/tts so the key never reaches browsers.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Vela owner console. Owner login is off until both are set. Generate the hash with:
#   python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
VELA_OWNER_EMAIL=""
VELA_OWNER_PASSWORD_HASH=""
VELA_OWNER_NAME=""

# Session lifetimes in seconds (staff default 12h, patients default 30 days).
VELA_SESSION_TTL=""
VELA_PATIENT_SESSION_TTL=""

# Login rate limit: attempts per window (seconds), per client IP and route.
VELA_LOGIN_RATE_LIMIT="10"
VELA_LOGIN_RATE_WINDOW="300"
# Set to "true" only behind a proxy you control, so X-Forwarded-For is trusted.
VELA_TRUST_PROXY=""

# Upload size limit in MB.
VELA_MAX_UPLOAD_MB="20"
