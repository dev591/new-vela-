# Backend API (FastAPI + Socket.IO). Defaults to http://localhost:8000 when unset.
VITE_API_URL=""
VITE_SOCKET_URL=""

VITE_GOOGLE_MAPS_KEY=""

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_MAPBOX_TOKEN=""

# Everything VITE_* is inlined into the public JS bundle — never put a secret
# here. The Gnani key lives in the backend .env (GNANI_API_KEY).

# Optional, demo machines only: shows a "Demo credentials" panel on the login
# screen. Leave unset for any real deployment.
VITE_DEMO_DOCTOR_PASSWORD=""
VITE_DEMO_RECEPTION_PASSWORD=""
VITE_DEMO_MANAGER_PASSWORD=""
VITE_DEMO_LAB_PASSWORD=""

# Judge-friendly demo path (Patient -> Reception -> Doctor). On by default; set to "false" to hide the
# guide, the credentials card and the one-hospital restriction.
VITE_DEMO_MODE=""
# The only hospital a demo patient can book at (defaults to the seeded VELA Care hospital).
VITE_DEMO_HOSPITAL_ID=""
# Demo patient (Rajesh Kumar). The backend needs the same password in DEMO_PATIENT_PASSWORD.
VITE_DEMO_PATIENT_EMAIL="patient@vela.ai"
VITE_DEMO_PATIENT_PASSWORD=""
